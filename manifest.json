{
  "manifest_version": 3,
  "name": "Canvas LMS Dark Mode",
  "version": "1.0.0",
  "description": "Dark theme, less sidebar clutter, and a fullscreen button for Canvas file viewers.",
  "author": "amahjoor",
  
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  
  "host_permissions": [
    "*://*.instructure.com/*",
    "*://*.canvas.instructure.com/*",
    "*://*.gmu.edu/*",
    "*://*.edu/*"
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Better Canvas - Enhance your Canvas experience",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "content_scripts": [
    {
      "matches": [
        "*://*.instructure.com/*",
        "*://*.canvas.instructure.com/*",
        "*://*.gmu.edu/*",
        "*://*.edu/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "icons/*.png"
      ],
      "matches": [
        "*://*.instructure.com/*",
        "*://*.canvas.instructure.com/*", 
        "*://*.gmu.edu/*",
        "*://*.edu/*"
      ]
    }
  ],
  
  "minimum_chrome_version": "88",
  
  "homepage_url": "https://github.com/amahjoor/canvas-lms-dark-mode",
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}