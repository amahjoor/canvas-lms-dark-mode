{
  "manifest_version": 3,
  "name": "Better Canvas",
  "version": "1.0.0",
  "description": "Enhance Canvas with dark mode, bloat removal, and fullscreen presentations",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.instructure.com/*",
    "*://*.canvas.instructure.com/*",
    "*://*.gmu.edu/*",
    "*://*.edu/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Better Canvas",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instructure.com/*",
        "*://*.canvas.instructure.com/*",
        "*://*.gmu.edu/*",
        "*://*.edu/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
